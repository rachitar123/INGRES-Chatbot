# Copy this file to .env (never commit .env)
# DATABASE_URL is automatically provided by Render's managed PostgreSQL.
# On Render, set all variables below in the service's Environment settings.

# Required on Render — auto-wired from the PostgreSQL service via render.yaml
DATABASE_URL=postgresql://ingres_user:your_password@localhost:5432/ingres_db

# Set to "false" when Rasa is not deployed (uses pattern-matching fallback)
USE_RASA=false

# Uncomment and set when Rasa is deployed
# RASA_SERVER_URL=https://your-rasa-service.onrender.com
